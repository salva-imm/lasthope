# Copy to .env (gitignored) and fill in. Real environment variables override this file.
# Any OpenAI-compatible provider works; switch providers by changing these three.

# Groq (free tier). Pick a current model from https://console.groq.com/docs/models
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Other examples:
#   Cerebras:  LLM_BASE_URL=https://api.cerebras.ai/v1
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1
#   Local:     LLM_BASE_URL=http://localhost:11434/v1   (ollama; any non-empty key)

# Microphone: part of a device name, or "default". Unset = the system default,
# except a headset's own mic is avoided when another exists: Bluetooth headsets
# drop to phone-call quality while their mic is open. See: lasthope --mics
# MIC_DEVICE=MacBook

# Silence (ms) that ends your turn; shorter pauses stay in the same sentence.
# END_OF_TURN_MS=1200

# Optional model locations (defaults shown)
# KOKORO_DIR=./kokoro-multi-lang-v1_0
# MODELS_DIR=./models
